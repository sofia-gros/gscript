// Go-style declarations and methods, JavaScript-style APIs.
type Person struct {
  Name string
}

func (p Person) Greet() string {
  return "Hello, " + p.Name
}

func greet(name string) string {
  return "Hello, " + name
}

name := "Sofia"
console.log(greet(name))
p := Person{Name: name}
console.log(p.Greet())

numbers := []int{1, 2, 3}
doubled := numbers.map(func(n int) int {
  return n * 2
})
for i, n := range doubled {
  console.log(i, n)
}

user := {name: name, age: 28}
updated := {...user, age: 29}
console.log(updated.name, updated.age)
