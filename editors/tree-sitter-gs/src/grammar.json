{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "gs",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_item"
      }
    },
    "_item": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "keyword"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "operator"
        },
        {
          "type": "SYMBOL",
          "name": "delimiter"
        },
        {
          "type": "SYMBOL",
          "name": "block"
        },
        {
          "type": "SYMBOL",
          "name": "parenthesized"
        },
        {
          "type": "SYMBOL",
          "name": "indexed"
        }
      ]
    },
    "block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_item"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "parenthesized": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_item"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "indexed": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_item"
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[A-Za-z_$][A-Za-z0-9_$]*"
    },
    "keyword": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "func"
            },
            {
              "type": "STRING",
              "value": "type"
            },
            {
              "type": "STRING",
              "value": "struct"
            },
            {
              "type": "STRING",
              "value": "interface"
            },
            {
              "type": "STRING",
              "value": "enum"
            },
            {
              "type": "STRING",
              "value": "extends"
            },
            {
              "type": "STRING",
              "value": "implements"
            },
            {
              "type": "STRING",
              "value": "constructor"
            },
            {
              "type": "STRING",
              "value": "super"
            },
            {
              "type": "STRING",
              "value": "override"
            },
            {
              "type": "STRING",
              "value": "static"
            },
            {
              "type": "STRING",
              "value": "public"
            },
            {
              "type": "STRING",
              "value": "private"
            },
            {
              "type": "STRING",
              "value": "protected"
            },
            {
              "type": "STRING",
              "value": "readonly"
            },
            {
              "type": "STRING",
              "value": "var"
            },
            {
              "type": "STRING",
              "value": "const"
            },
            {
              "type": "STRING",
              "value": "return"
            },
            {
              "type": "STRING",
              "value": "if"
            },
            {
              "type": "STRING",
              "value": "else"
            },
            {
              "type": "STRING",
              "value": "for"
            },
            {
              "type": "STRING",
              "value": "range"
            },
            {
              "type": "STRING",
              "value": "switch"
            },
            {
              "type": "STRING",
              "value": "case"
            },
            {
              "type": "STRING",
              "value": "default"
            },
            {
              "type": "STRING",
              "value": "break"
            },
            {
              "type": "STRING",
              "value": "continue"
            },
            {
              "type": "STRING",
              "value": "async"
            },
            {
              "type": "STRING",
              "value": "await"
            },
            {
              "type": "STRING",
              "value": "new"
            },
            {
              "type": "STRING",
              "value": "export"
            },
            {
              "type": "STRING",
              "value": "import"
            },
            {
              "type": "STRING",
              "value": "from"
            },
            {
              "type": "STRING",
              "value": "as"
            },
            {
              "type": "STRING",
              "value": "true"
            },
            {
              "type": "STRING",
              "value": "false"
            },
            {
              "type": "STRING",
              "value": "nil"
            },
            {
              "type": "STRING",
              "value": "undefined"
            },
            {
              "type": "STRING",
              "value": "int"
            },
            {
              "type": "STRING",
              "value": "float"
            },
            {
              "type": "STRING",
              "value": "number"
            },
            {
              "type": "STRING",
              "value": "string"
            },
            {
              "type": "STRING",
              "value": "bool"
            },
            {
              "type": "STRING",
              "value": "any"
            },
            {
              "type": "STRING",
              "value": "void"
            }
          ]
        }
      }
    },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "\"([^\"\\\\\\n]|\\\\.)*\""
          },
          {
            "type": "PATTERN",
            "value": "'([^'\\\\\\n]|\\\\.)*'"
          }
        ]
      }
    },
    "number": {
      "type": "PATTERN",
      "value": "[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?"
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "\\/\\/[^\\n]*"
          },
          {
            "type": "PATTERN",
            "value": "\\/\\*[^*]*\\*+([^/*][^*]*\\*+)*\\/"
          }
        ]
      }
    },
    "operator": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "STRING",
            "value": "..."
          },
          {
            "type": "STRING",
            "value": "?."
          },
          {
            "type": "STRING",
            "value": "??"
          },
          {
            "type": "STRING",
            "value": ":="
          },
          {
            "type": "STRING",
            "value": "=="
          },
          {
            "type": "STRING",
            "value": "!="
          },
          {
            "type": "STRING",
            "value": "<="
          },
          {
            "type": "STRING",
            "value": ">="
          },
          {
            "type": "STRING",
            "value": "&&"
          },
          {
            "type": "STRING",
            "value": "||"
          },
          {
            "type": "STRING",
            "value": "++"
          },
          {
            "type": "STRING",
            "value": "--"
          },
          {
            "type": "STRING",
            "value": "+="
          },
          {
            "type": "STRING",
            "value": "-="
          },
          {
            "type": "PATTERN",
            "value": "[=+*\\/%!<>?|&-]"
          }
        ]
      }
    },
    "delimiter": {
      "type": "PATTERN",
      "value": "[.,:;]"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}