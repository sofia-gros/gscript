{
  "name": "gscript",
  "displayName": "GS / gscript",
  "description": "GS compiler diagnostics, completion, definition, references, rename, signatures and formatting.",
  "version": "0.6.1",
  "publisher": "sofia-gros",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sofia-gros/gscript"
  },
  "license": "UNLICENSED",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:gscript"
  ],
  "scripts": {
    "build": "python ../../scripts/build_plugins.py --portable --output server && esbuild extension.js --bundle --platform=node --external:vscode --outfile=dist/extension.js",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "3.6.2",
    "esbuild": "0.25.12",
    "@vscode/test-electron": "2.5.2"
  },
  "contributes": {
    "languages": [
      {
        "id": "gscript",
        "aliases": [
          "GS",
          "gscript"
        ],
        "extensions": [
          ".gs",
          ".gos"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gscript",
        "scopeName": "source.gscript",
        "path": "./syntaxes/gs.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "GS",
      "properties": {
        "gscript.server.path": {
          "type": "string",
          "default": "",
          "description": "Optional native server or Python executable path. Empty: detect gs-lsp 0.6.1, otherwise run the bundled server with Python 3.12+."
        },
        "gscript.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "--stdio"
          ],
          "description": "Language server arguments. Reload the window after changing server settings."
        },
        "gscript.strictNull": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Override strict null checks. Null uses gsconfig.json. Reload after changing."
        }
      }
    }
  }
}
